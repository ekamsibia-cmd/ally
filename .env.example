# Public: safe to expose in the browser (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Secret: server only. Never prefix with NEXT_PUBLIC_. Optional; the AI buttons need it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
